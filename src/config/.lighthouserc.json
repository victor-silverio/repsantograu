{
  "ci": {
    "collect": {
      "startServerCommand": "npx http-server dist -p 3001 -c-1",
      "startServerReadyPattern": "Available on",
      "startServerReadyTimeout": 15000,
      "url": [
        "http://localhost:3001/index.html",
        "http://localhost:3001/fotos/index.html"
      ],
      "numberOfRuns": 2,
      "settings": {
        "chromeFlags": "--no-sandbox --headless --disable-dev-shm-usage"
      }
    },
    "assert": {
      "preset": "lighthouse:no-pwa",
      "assertions": {
        "categories:performance": [
          "warn",
          { "minScore": 0.75, "aggregationMethod": "median-run" }
        ],
        "categories:accessibility": [
          "error",
          { "minScore": 0.9, "aggregationMethod": "median-run" }
        ],
        "categories:best-practices": [
          "warn",
          { "minScore": 0.9, "aggregationMethod": "median-run" }
        ],
        "categories:seo": [
          "error",
          { "minScore": 0.95, "aggregationMethod": "median-run" }
        ],

        "largest-contentful-paint": ["warn", { "minScore": 0.4 }],
        "bf-cache": "off",
        "uses-responsive-images": "warn",
        "color-contrast": "warn",
        "interactive": "warn",
        "mainthread-work-breakdown": "warn",
        "max-potential-fid": "warn",

        "unminified-css": "off",
        "unused-javascript": "off",
        "uses-rel-preload": "off",
        "uses-rel-preconnect": "off",
        "legacy-javascript": "off",
        "uses-http2": "off",

        "uses-text-compression": "off",
        "uses-long-cache-ttl": "off",
        "cache-insight": "off",
        "document-latency-insight": "off",
        "render-blocking-resources": "off",
        "render-blocking-insight": "off",
        "network-dependency-tree-insight": "off",

        "image-delivery-insight": "off",
        "lcp-discovery-insight": "off",
        "dom-size-insight": "off"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
